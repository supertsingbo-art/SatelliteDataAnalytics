{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "ClickHouse": "Host=localhost;Port=8123;Username=default;Password=1234;",
    "Postgres": "Host=localhost;Port=5432;Username=postgres;Password=postgres;Database=demo_db"
  },
  "AssetProviders": {
    "MassDataApiBaseUrl": "http://localhost:5000",
    "SatelliteAssetApiBaseUrl": "http://localhost:5001",
    "MinioBaseUrl": "http://localhost:9000",
    "DefaultDbStage": "DEV"
  },
  "OAuth": {
    "Issuer": "satellite-data-platform",
    "Audience": "satellite-data-openapi",
    "SigningKey": "dev-only-change-before-production-very-long-signing-key",
    "DefaultTokenTtlSeconds": 7200,
    "SeedClients": []
  },
  "AssetCache": {
    "UsePostgreSql": true
  },
  "Pipeline": {
    "Storage": "Memory",
    "RunWorkerInApi": true,
    "UsePostgreSqlTaskStore": false,
    "SyntheticMongoWhenEmpty": true,
    "MongoRawCollection": "parameter_raw",
    "ClickHouseBatchSize": 100000
  }
}
